# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=        # ID del número en Meta Developers
WHATSAPP_ACCESS_TOKEN=           # Token permanente de usuario del sistema
WHATSAPP_VERIFY_TOKEN=           # Token secreto para verificar webhook

# Supabase
SUPABASE_URL=                    # URL del proyecto Supabase
SUPABASE_SERVICE_ROLE_KEY=       # Service role key (solo servidor)
NEXT_PUBLIC_SUPABASE_URL=        # Misma URL (para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Anon key pública

# OpenRouter (DeepSeek)
OPENROUTER_API_KEY=              # Key de OpenRouter

# Resend (emails)
RESEND_API_KEY=                  # Key de Resend
NOTIFY_EMAIL=                    # Email(s) para notificaciones (separar por coma si son varios)

# Vercel Cron authentication
CRON_SECRET=                     # String secreto para autenticar los crons
