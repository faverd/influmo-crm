fair Display', serif !important; font-size: 20px !important; font-weight: 700 !important; color: #fff !important; text-shadow: 0 2px 10px rgba(0,0,0,0.35) !important; margin-bottom: 6px !important; } .adle-carousel .elementor-slide-description { font-family: 'DM Sans', sans-serif !important; font-size: 12px !important; color: rgba(255,255,255,0.82) !important; line-height: 1.5 !important; text-shadow: 0 1px 6px rgba(0,0,0,0.3) !important; }"
